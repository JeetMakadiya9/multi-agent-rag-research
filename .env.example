# Local configuration of the Research Studio. Copy this file to .env (ignored by git) and edit it.
# Nothing here is required: without a .env the Studio uses the local Ollama with qwen3:4b.
# Restart start_studio.bat after changing it. Never commit .env.

# ---- Language model --------------------------------------------------------------------------
# local (default) = Ollama on this computer; ollama = an Ollama server elsewhere; openai = an OpenAI-compatible API
# WEBRAG_LLM_PROVIDER=local
# WEBRAG_LLM_MODEL=qwen3:4b

# Example: an OpenAI-compatible API (placeholders, not real values)
# WEBRAG_LLM_PROVIDER=openai
# WEBRAG_LLM_BASE_URL=https://api.example.com/v1
# WEBRAG_LLM_MODEL=model-name
# WEBRAG_LLM_API_KEY=replace-with-your-key
# WEBRAG_LLM_JSON_MODE=schema
# WEBRAG_LLM_VERIFIER_MODEL=
# WEBRAG_LLM_TIMEOUT=180
#
# WEBRAG_LLM_JSON_MODE: schema | object | none (use object if the service rejects JSON schemas).
# WEBRAG_LLM_VERIFIER_MODEL: optional separate model for the verifier, on the same service.

# ---- Search providers (optional) -------------------------------------------------------------
# OPENALEX_API_KEY=
# WEBRAG_CONTACT=you@example.com
# SEARXNG_URL=
# BRAVE_API_KEY=
#
# OPENALEX_API_KEY: free key; avoids the shared anonymous daily budget.
# WEBRAG_CONTACT: contact address sent with requests to the search services.
# SEARXNG_URL: your own SearXNG instance. BRAVE_API_KEY: Brave Search API (paid).

# ---- Retrieval models ------------------------------------------------------------------------
# WEBRAG_MODEL_DOWNLOADS=auto
# auto: download the two retrieval models once if they are missing; 0 = never; 1 = allow.
